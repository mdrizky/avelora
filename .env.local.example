# AVELORA — contoh variabel lingkungan.
# Salin ke `.env.local` lalu isi sesuai kebutuhan.

# --- Penyimpanan ---------------------------------------------------------------
# DATABASE_STORE=local        -> file .data/db.json (default, tanpa DB eksternal)
# DATABASE_STORE=supabase     -> Postgres/Supabase (perlu dua kunci di bawah,
#                                dan supabase/schema.sql dijalankan lebih dulu)
DATABASE_STORE=local

# --- Supabase (hanya perlu bila DATABASE_STORE=supabase) -----------------------
# Project Settings > API > Project URL
SUPABASE_URL=
# Project Settings > API > service_role (RAHASIA — hanya untuk sisi server)
SUPABASE_SERVICE_ROLE_KEY=

# --- Keamanan sesi demo --------------------------------------------------------
# Ganti dengan nilai acak 32+ karakter. Jangan dipakai cookie sesi sementara.
AUTH_SECRET=

# --- Payment gateway (server-only, optional) ----------------------------------
# PAYMENT_GATEWAY=midtrans atau xendit. Tanpa credential, mode demo digunakan.
PAYMENT_GATEWAY=demo
PAYMENT_MODE=sandbox
MIDTRANS_SERVER_KEY=
XENDIT_SECRET_KEY=